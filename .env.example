# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Data source for the wheel dashboard: fixture | schwab
CHAI_SOURCE=schwab

# Schwab (read-only OAuth) — run the local login flow to create the token file
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=schwab_token.json
SCHWAB_ACCOUNT_HASH=

# Market/fundamental data
POLYGON_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=

# Macro / recession monitor (free key: fredaccount.stlouisfed.org)
FRED_API_KEY=

# AI (Ask tab). Anthropic primary, OpenRouter fallback.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: path to a shared .env with additional keys
# CHAI_SHARED_ENV=
